{
  "name": "claude-talking",
  "version": "1.0.0",
  "description": "桌面语音助手 - 与 Claude 语音对话",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.claude.talking",
    "productName": "Claude桌面助手",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于语音输入与Claude对话"
      }
    },
    "extraResources": [
      { "from": "../brain.js", "to": "lib/brain.js" },
      { "from": "../stt.js", "to": "lib/stt.js" },
      { "from": "../tts.js", "to": "lib/tts.js" },
      { "from": "../audio.js", "to": "lib/audio.js" },
      { "from": "../config.json", "to": "lib/config.json" },
      { "from": "../node_modules", "to": "lib/node_modules" }
    ],
    "asar": false,
    "directories": {
      "output": "dist"
    }
  }
}
